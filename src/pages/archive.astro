---
/**
 * Seminar archive: every past week held in data/archives.
 * Author: Dr. Denys Dutykh (Khalifa University of Science and Technology, Abu Dhabi, UAE)
 * License: GNU General Public License v3.0
 */
import { loadArchivedWeeks } from '../lib/data';
import { formatWeekRange } from '../lib/time';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeriesSection from '../components/SeriesSection.astro';
import Calendar from '../components/icons/Calendar.astro';
import ChevronRight from '../components/icons/ChevronRight.astro';

const SITE = 'https://www.events.denys-dutykh.com';

const archivedWeeks = loadArchivedWeeks();

// Keep only weeks that actually held seminars; empty holiday/exam weeks add
// nothing to an archive.
const weeks = archivedWeeks
  .filter((entry) => entry.data.seminars.length > 0)
  .map((entry) => {
    const { data } = entry;
    const seriesList = data.series;
    const knownSeries = new Set(seriesList.map((s) => s.code));

    const grouped = new Map<string, typeof data.seminars>();
    for (const seminar of data.seminars) {
      const group = grouped.get(seminar.series);
      if (group) group.push(seminar);
      else grouped.set(seminar.series, [seminar]);
    }

    const orderedSeries = [
      ...seriesList,
      ...[...new Set(data.seminars.map((s) => s.series))]
        .filter((code) => !knownSeries.has(code))
        .sort()
        .map((code) => ({ code, label: code.toUpperCase() }))
    ].filter((meta) => grouped.has(meta.code));

    return {
      ...entry,
      timezone: data.week.timezone,
      rangeLabel: formatWeekRange(
        data.week.start,
        data.week.end,
        data.week.isoWeek,
        data.week.timezone
      ),
      grouped,
      orderedSeries,
      seminarCount: data.seminars.length
    };
  });

const totalSeminars = weeks.reduce((sum, week) => sum + week.seminarCount, 0);
const speakerCount = new Set(
  weeks.flatMap((week) => week.data.seminars.map((s) => s.speaker))
).size;

const years = [...new Set(weeks.map((w) => w.year))].sort((a, b) => b - a);
const yearLabel =
  years.length === 0 ? '' : years.length === 1 ? `${years[0]}` : `${years[years.length - 1]}–${years[0]}`;

const pageTitle = 'Seminar archive | Mathematics Department, Khalifa University';
const pageDescription = totalSeminars
  ? `Archive of ${totalSeminars} past mathematics seminars (${speakerCount} speakers${
      yearLabel ? `, ${yearLabel}` : ''
    }) hosted by the Mathematics Department at Khalifa University, Abu Dhabi.`
  : 'Archive of past mathematics seminars at Khalifa University, Abu Dhabi.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE}/archive`,
  url: `${SITE}/archive`,
  name: pageTitle,
  description: pageDescription,
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: weeks.flatMap((week) =>
    week.data.seminars.map((seminar) => ({
      '@type': 'Event',
      name: seminar.title,
      startDate: seminar.start,
      ...(seminar.end && { endDate: seminar.end }),
      eventStatus:
        seminar.status === 'cancelled'
          ? 'https://schema.org/EventCancelled'
          : 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: seminar.location,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Abu Dhabi',
          addressCountry: 'UAE'
        }
      },
      performer: {
        '@type': 'Person',
        name: seminar.speaker,
        ...(seminar.affiliation && { affiliation: seminar.affiliation })
      },
      organizer: { '@id': 'https://www.ku.ac.ae/#organization' }
    }))
  )
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE}/archive`}
  keywords="mathematics seminars archive, past seminars, Khalifa University, Abu Dhabi, research talks"
  structuredData={structuredData}
>
  <header class="bg-gradient-to-r from-ku-primary/15 via-surface/95 to-ku-accent/15 backdrop-blur-lg border-b-2 border-ku-primary/25 shadow-large">
    <div class="container max-w-4xl mx-auto px-6 py-12 md:px-8 lg:px-12 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-ku-primary hover:text-ku-accent transition-colors duration-300"
      >
        <span aria-hidden="true">←</span> This week's seminars
      </a>

      <h1 class="mt-6 text-4xl md:text-5xl font-bold bg-gradient-to-r from-ku-primary via-ku-accent to-ku-primary bg-clip-text text-transparent">
        Seminar Archive
      </h1>
      <p class="mt-3 text-lg text-ku-primary font-semibold">Mathematics Department, Khalifa University</p>

      {totalSeminars > 0 && (
        <dl class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm">
          <div class="rounded-full border border-ku-primary/20 bg-surface-elevated/70 px-4 py-2">
            <dt class="inline font-semibold text-ku-primary">{totalSeminars}</dt>
            <dd class="inline text-foreground-secondary"> seminars</dd>
          </div>
          <div class="rounded-full border border-ku-primary/20 bg-surface-elevated/70 px-4 py-2">
            <dt class="inline font-semibold text-ku-primary">{speakerCount}</dt>
            <dd class="inline text-foreground-secondary"> speakers</dd>
          </div>
          <div class="rounded-full border border-ku-primary/20 bg-surface-elevated/70 px-4 py-2">
            <dt class="inline font-semibold text-ku-primary">{weeks.length}</dt>
            <dd class="inline text-foreground-secondary"> weeks{yearLabel ? `, ${yearLabel}` : ''}</dd>
          </div>
        </dl>
      )}
    </div>
  </header>

  <main id="main-content" class="container max-w-4xl mx-auto px-6 py-10 md:px-8 lg:px-12">
    {weeks.length === 0 ? (
      <div class="card-elevated rounded-2xl p-8 text-center">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-ku-primary/10 text-ku-primary">
          <Calendar size={32} class="stroke-current" />
        </div>
        <h2 class="text-xl font-semibold text-foreground mb-2">The archive is empty</h2>
        <p class="text-muted">Past seminar weeks will appear here once they are archived.</p>
      </div>
    ) : (
      <>
        <nav class="mb-12" aria-label="Archived weeks">
          <h2 class="text-sm font-semibold uppercase tracking-[0.3em] text-ku-secondary mb-4">
            Jump to a week
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {weeks.map((week) => (
              <li>
                <a
                  href={`#${week.slug}`}
                  class="group flex items-center justify-between gap-3 rounded-xl border border-border-subtle bg-surface px-4 py-3 shadow-subtle hover:border-ku-primary/40 hover:shadow-medium transition-all duration-300"
                >
                  <span>
                    <span class="block text-sm font-semibold text-ku-primary">
                      Week {week.data.week.isoWeek}, {week.year}
                    </span>
                    <span class="block text-xs text-muted">
                      {week.seminarCount} {week.seminarCount === 1 ? 'seminar' : 'seminars'}
                    </span>
                  </span>
                  <ChevronRight
                    size={16}
                    class="text-ku-primary transition-transform duration-300 group-hover:translate-x-1"
                  />
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="space-y-20">
          {weeks.map((week) => (
            <section id={week.slug} class="scroll-mt-8" aria-label={week.rangeLabel}>
              <div class="mb-10 rounded-2xl border border-ku-primary/20 bg-gradient-to-br from-ku-primary/10 via-surface to-ku-accent/5 p-6 text-center shadow-medium">
                <h2 class="text-2xl font-bold text-ku-primary">{week.rangeLabel}</h2>
                {week.data.week.semester && (
                  <p class="mt-1 text-sm text-foreground-secondary">{week.data.week.semester}</p>
                )}
              </div>

              <div class="space-y-12">
                {week.orderedSeries.map((seriesMeta) => (
                  <SeriesSection
                    seriesCode={seriesMeta.code}
                    seriesInfo={{
                      series: seriesMeta,
                      seminars: week.grouped.get(seriesMeta.code) ?? []
                    }}
                    timezone={week.timezone}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      </>
    )}
  </main>

  <SiteFooter />
</BaseLayout>
