---
/**
 * KU Math Seminars - Main Page
 * Author: Dr. Denys Dutykh (Khalifa University of Science and Technology, Abu Dhabi, UAE)
 * License: GNU General Public License v3.0
 */
import type { WeekInfo, WeekStatus } from '../lib/types';
import { loadCurrentWeek } from '../lib/data';
import { formatWeekRange } from '../lib/time';
import BaseLayout from '../layouts/BaseLayout.astro';
import WeekHeader from '../components/WeekHeader.astro';
import SeriesSection from '../components/SeriesSection.astro';
import JobInterviewsSection from '../components/JobInterviewsSection.astro';
import WeeklySummary from '../components/WeeklySummary.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Calendar from '../components/icons/Calendar.astro';

const SITE = 'https://www.events.denys-dutykh.com';

const weekData = loadCurrentWeek();
const { week } = weekData;
const seminarsList = weekData.seminars;
const interviewsList = weekData.interviews;
const seriesList = weekData.series;

const interviewPanelDefault = [
  'Dr. Denys Dutykh',
  'Prof Ahmed Ameur',
  'Prof Mohammad Al-Khaleel'
];

// Group seminars by series, keeping the configured series order and appending
// any series code that appears in the data but has no metadata entry.
const groupedSeminars = new Map<string, typeof seminarsList>();
for (const seminar of seminarsList) {
  const group = groupedSeminars.get(seminar.series);
  if (group) group.push(seminar);
  else groupedSeminars.set(seminar.series, [seminar]);
}

const knownSeries = new Set(seriesList.map((s) => s.code));
const unknownCodes = [...new Set(seminarsList.map((s) => s.series))]
  .filter((code) => !knownSeries.has(code))
  .sort();

const allSeries = [
  ...seriesList,
  ...unknownCodes.map((code) => ({ code, label: code.toUpperCase() }))
];

const timezone = week.timezone;
const currentSemester = week.semester?.trim();
const nextSemester = week.nextSemester?.trim();
const resumeDate = week.resumeDate?.trim();
const weekRangeSummary = formatWeekRange(week.start, week.end, week.isoWeek, timezone);

type WeekStatusBanner = {
  title: string;
  defaultMessage: string;
  icon: string;
  className: string;
  titleClass: string;
  getMessage?: (week: WeekInfo) => string;
};

const buildStandbyMessage = (info: WeekInfo) => {
  const semester = info.semester?.trim();
  const upcoming = info.nextSemester?.trim();
  const targetDate = info.resumeDate?.trim();

  const parts = [
    semester
      ? `${semester} seminar season has concluded.`
      : 'The current seminar season has concluded.'
  ];

  if (upcoming && targetDate) {
    parts.push(`Seminars resume in ${upcoming} on ${targetDate} after exams.`);
  } else if (upcoming) {
    parts.push(`Seminars resume in ${upcoming} after exams.`);
  } else if (targetDate) {
    parts.push(`Seminars resume on ${targetDate} after exams.`);
  } else {
    parts.push('Seminars will resume after the examination period.');
  }

  return parts.join(' ');
};

const weekStatus = week.status;
const weekStatusBanners: Record<WeekStatus, WeekStatusBanner | null> = {
  open: null,
  holiday: {
    title: 'University Holiday',
    defaultMessage: 'Seminars pause this week while the university observes a holiday.',
    icon: '🎉',
    className: 'bg-status-holiday/10 border-status-holiday/40',
    titleClass: 'text-status-holiday'
  },
  break: {
    title: 'Academic Break',
    defaultMessage: 'No seminars are scheduled during the academic break.',
    icon: '🧭',
    className: 'bg-status-break/10 border-status-break/40',
    titleClass: 'text-status-break'
  },
  exams: {
    title: 'Examination Period',
    defaultMessage: 'Seminars are on hold while examinations are in progress.',
    icon: '📝',
    className: 'bg-status-exams/10 border-status-exams/40',
    titleClass: 'text-status-exams'
  },
  standby: {
    title: 'Seminars on Standby',
    defaultMessage: 'Seminars are paused between semesters while exams are underway.',
    icon: '⏳',
    className: 'bg-status-standby/10 border-status-standby/40',
    titleClass: 'text-status-standby',
    getMessage: buildStandbyMessage
  },
  cancelled: {
    title: 'Week Cancelled',
    defaultMessage: "This week's seminar programme is cancelled.",
    icon: '⚠️',
    className: 'bg-status-cancelled/10 border-status-cancelled/40',
    titleClass: 'text-status-cancelled'
  }
};

const statusInfo = weekStatusBanners[weekStatus];
const statusNote = week.note?.trim() ?? '';
const statusMessage =
  statusNote || statusInfo?.getMessage?.(week) || statusInfo?.defaultMessage || '';

// --- SEO -------------------------------------------------------------------

const seminarCount = seminarsList.length;
const interviewCount = interviewsList.length;
const totalEvents = seminarCount + interviewCount;
const hasSeminars = seminarCount > 0;
const hasInterviews = interviewCount > 0;
const hasEvents = totalEvents > 0;
const weekNumber = week.isoWeek;
const currentYear = new Date(week.start).getFullYear();

const standbyDescription = (() => {
  if (weekStatus !== 'standby') return '';
  if (statusMessage) return statusMessage;

  const intro = currentSemester
    ? `${currentSemester} seminar season has concluded.`
    : 'The current seminar season has concluded.';

  if (nextSemester && resumeDate) {
    return `${intro} Seminars resume in ${nextSemester} (targeting ${resumeDate}) after examinations.`;
  }
  if (nextSemester) return `${intro} Seminars resume in ${nextSemester} after examinations.`;
  if (resumeDate) return `${intro} Seminars resume on ${resumeDate} after examinations.`;
  return `${intro} Seminars resume after examinations.`;
})();

const noEventsDescription =
  weekStatus === 'standby'
    ? standbyDescription
    : `Mathematics Department seminars for Week ${weekNumber}, ${currentYear} at Khalifa University, Abu Dhabi, UAE.`;

const defaultTitle = `Week ${weekNumber} - Mathematics Department, Khalifa University`;
const standbyTitle =
  weekStatus === 'standby'
    ? `${nextSemester || 'Upcoming semester'} seminars resume soon – Khalifa University`
    : defaultTitle;

const pageTitle = hasEvents
  ? `Week ${weekNumber} Academic Events (${totalEvents}) - Mathematics Department, Khalifa University`
  : standbyTitle;

const featuredNames = [
  ...seminarsList.slice(0, 3).map((s) => s.speaker),
  ...interviewsList.slice(0, 2).map((i) => i.candidate)
]
  .filter(Boolean)
  .join(', ');

const pageDescription = hasEvents
  ? `Join us for ${seminarCount} mathematics seminars${
      hasInterviews ? ` and ${interviewCount} faculty job interviews` : ''
    } in Week ${weekNumber}, ${currentYear}. Featured participants: ${
      featuredNames || 'international guests'
    }. Abu Dhabi, UAE.`
  : noEventsDescription;

const keywordParts = [
  'mathematics',
  'seminars',
  'Khalifa University',
  'Abu Dhabi',
  'research',
  'talks',
  'academic events',
  'job interviews',
  'faculty recruitment',
  ...seminarsList.flatMap((s) => s.tags ?? []),
  ...interviewsList.map((i) => i.position),
  currentSemester,
  nextSemester
].filter(Boolean);
const pageKeywords = [...new Set(keywordParts)].join(', ');

// Cache-busting token so social scrapers refresh the preview each week.
const ogImageUrl = `${SITE}/assets/og-image.png?v=${currentYear}-${weekNumber}`;

const seminarEntities = seminarsList.map((seminar, index) => ({
  '@type': 'Event',
  '@id': `${SITE}/#event${index}`,
  name: seminar.title,
  description: seminar.abstract ? `${seminar.abstract.substring(0, 200)}...` : 'Mathematics seminar',
  startDate: seminar.start,
  ...(seminar.end && { endDate: seminar.end }),
  eventStatus:
    seminar.status === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : seminar.status === 'postponed'
        ? 'https://schema.org/EventPostponed'
        : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: seminar.location,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Abu Dhabi',
      addressCountry: 'UAE'
    }
  },
  organizer: { '@id': 'https://www.ku.ac.ae/#organization' },
  performer: {
    '@type': 'Person',
    name: seminar.speaker,
    ...(seminar.affiliation && { affiliation: seminar.affiliation }),
    ...(seminar.affiliationUrl && { url: seminar.affiliationUrl }),
    jobTitle: 'Researcher'
  },
  ...(seminar.tags && { keywords: seminar.tags.join(', ') }),
  isAccessibleForFree: true,
  audience: {
    '@type': 'EducationalAudience',
    educationalRole: 'student, faculty, researcher'
  }
}));

const interviewEntities = interviewsList.map((interview, index) => ({
  '@type': 'Event',
  '@id': `${SITE}/#jobinterview${index}`,
  name: `Job Interview: ${interview.candidate} (${interview.position})`,
  description: `Faculty ${interview.interviewType} interview for the ${interview.position} position.`,
  startDate: interview.start,
  endDate: interview.end,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode:
    interview.mode === 'virtual'
      ? 'https://schema.org/OnlineEventAttendanceMode'
      : 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: interview.location,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Abu Dhabi',
      addressCountry: 'UAE'
    }
  },
  organizer: { '@id': 'https://www.ku.ac.ae/#organization' },
  audience: {
    '@type': 'EducationalAudience',
    educationalRole: 'faculty, recruitment committee'
  }
}));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.ku.ac.ae/#organization',
      name: 'Khalifa University',
      url: 'https://www.ku.ac.ae/',
      logo: {
        '@type': 'ImageObject',
        url: `${SITE}/assets/KUlogo.png`
      },
      sameAs: [
        'https://en.wikipedia.org/wiki/Khalifa_University',
        'https://x.com/KhalifaUni',
        'https://www.linkedin.com/school/khalifa-university/'
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Academic Department',
        email: 'denys.dutykh@ku.ac.ae'
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Abu Dhabi',
        addressCountry: 'UAE'
      },
      department: {
        '@type': 'Organization',
        name: 'Mathematics Department',
        parentOrganization: { '@id': 'https://www.ku.ac.ae/#organization' }
      }
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'KU Mathematics Seminars',
      description: pageDescription,
      publisher: { '@id': 'https://www.ku.ac.ae/#organization' },
      inLanguage: 'en-US',
      image: {
        '@type': 'ImageObject',
        url: ogImageUrl,
        width: 1200,
        height: 630
      }
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE}/#webpage`,
      url: `${SITE}/`,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${SITE}/#website` },
      image: ogImageUrl,
      about: { '@type': 'Thing', name: 'Mathematics Seminars' },
      mainEntity: [...seminarEntities, ...interviewEntities]
    }
  ]
};

// Only the fields the PDF export needs are exposed to the browser.
const clientWeekData = {
  week,
  series: seriesList,
  seminars: seminarsList
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={`${SITE}/`}
  ogImage={ogImageUrl}
  structuredData={structuredData}
>
  <WeekHeader weekData={weekData} />

  <main id="main-content" class="container max-w-4xl mx-auto px-6 py-8 md:px-8 lg:px-12">
    <WeeklySummary
      seminars={seminarsList}
      interviews={interviewsList}
      timezone={timezone}
      seriesList={seriesList}
      weekRangeSummary={weekRangeSummary}
    />

    <div class="mb-8 space-y-3">
      <div id="week-range" class="sr-only">{weekRangeSummary}</div>
      {statusInfo && (
        <div
          id="banner"
          class={`flex items-start gap-3 rounded-xl border px-4 py-3 text-sm shadow-subtle bg-background-subtle/90 ${statusInfo.className}`}
          role="status"
          aria-live="polite"
        >
          <span class="text-2xl" aria-hidden="true">{statusInfo.icon}</span>
          <div class="space-y-1 text-left">
            <div class={`font-semibold ${statusInfo.titleClass}`}>{statusInfo.title}</div>
            {statusMessage && (
              <p class="text-sm text-foreground-secondary font-normal">{statusMessage}</p>
            )}
          </div>
        </div>
      )}
    </div>

    <section id="content" class="space-y-12">
      {hasInterviews && (
        <JobInterviewsSection
          interviews={interviewsList}
          timezone={timezone}
          defaultPanel={interviewPanelDefault}
        />
      )}

      {hasSeminars ? (
        allSeries.map((seriesMeta, index) => {
          const seminars = groupedSeminars.get(seriesMeta.code) ?? [];
          if (!seminars.length) return null;

          return (
            <div>
              {index > 0 && (
                <div class="flex items-center justify-center my-8" aria-hidden="true">
                  <div class="grow h-px bg-gradient-to-r from-transparent via-ku-secondary/30 to-transparent"></div>
                  <div class="mx-6 flex items-center space-x-3">
                    <div class="w-2 h-2 rounded-full bg-ku-accent/40"></div>
                    <div class="w-1 h-1 rounded-full bg-ku-accent/60"></div>
                    <div class="w-2 h-2 rounded-full bg-ku-accent/40"></div>
                  </div>
                  <div class="grow h-px bg-gradient-to-r from-transparent via-ku-secondary/30 to-transparent"></div>
                </div>
              )}
              <SeriesSection
                seriesCode={seriesMeta.code}
                seriesInfo={{ series: seriesMeta, seminars }}
                timezone={timezone}
              />
            </div>
          );
        })
      ) : (
        !hasInterviews && (
          <div class="card-elevated rounded-2xl p-8 text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-ku-primary/10 text-ku-primary">
              <Calendar size={32} class="stroke-current" />
            </div>
            <h2 class="text-xl font-semibold text-foreground mb-2">No seminars scheduled</h2>
            <p class="text-muted">
              {statusMessage || 'Check back next week for upcoming events.'}
            </p>
          </div>
        )
      )}
    </section>
  </main>

  <SiteFooter />

  <!-- Data block for the PDF export. Not executable, so it is inert to CSP. -->
  <script
    type="application/json"
    id="ku-week-data"
    is:inline
    set:html={JSON.stringify(clientWeekData)}
  />
</BaseLayout>

<script>
  import type { WeekData } from '../lib/types';

  /** Wire both Export PDF buttons; jsPDF is fetched only on first click. */
  const buttons = document.querySelectorAll<HTMLButtonElement>('.export-pdf-button');
  const dataNode = document.getElementById('ku-week-data');

  if (buttons.length && dataNode?.textContent) {
    const weekData = JSON.parse(dataNode.textContent) as WeekData;

    buttons.forEach((button) => {
      button.addEventListener('click', async () => {
        const original = button.textContent;
        button.disabled = true;

        try {
          const { generateSeminarPoster } = await import('../scripts/pdf-export');
          await generateSeminarPoster(weekData);
        } catch (error) {
          console.error('Error generating PDF:', error);
          button.textContent = 'PDF failed, retry';
          window.setTimeout(() => {
            button.textContent = original;
          }, 4000);
        } finally {
          button.disabled = false;
        }
      });
    });
  }
</script>
